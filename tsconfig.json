{
  "compilerOptions": {
    /* Language and Environment */
    "target": "ES2021",                          // Modern JS output
    "lib": ["ES2021"],                           // Use latest ECMAScript features
    // Add "DOM" if targeting browsers: ["DOM", "ES2021"]

    /* Modules */
    "module": "commonjs",                        // For Node.js; use "ESNext" for ESM
    "moduleResolution": "node",                  // Node-style module resolution
    "outDir": "./dist",                          // Output directory
    "rootDir": "./src",                          // Source root directory
    "resolveJsonModule": true,                   // Allow importing .json files
    "esModuleInterop": true,                     // Allow default imports from CJS modules
    "forceConsistentCasingInFileNames": true,    // Enforce import casing

    /* JavaScript Support */
    // "allowJs": true,                          // Uncomment if you want to include JS files

    /* Emit */
    "sourceMap": true,                           // Generate source maps for debugging
    "declaration": true,                         // Generate .d.ts files (for libraries)
    "declarationMap": true,                      // Map .d.ts files to source
    "removeComments": false,                     // Keep comments in output
    "noEmitOnError": true,                       // Don't emit if errors

    /* Interop Constraints */
    "allowSyntheticDefaultImports": true,        // Allow default imports from modules with no default export

    /* Type Checking */
    "strict": true,                              // Enable all strict type-checking options
    "noUnusedLocals": true,                      // Error on unused locals
    "noUnusedParameters": true,                  // Error on unused parameters
    "noImplicitReturns": true,                   // Error on missing return in functions
    "noFallthroughCasesInSwitch": true,          // Error on fallthrough in switch

    /* Completeness */
    "skipLibCheck": true,                         // Skip type checking of declaration files
    "strictPropertyInitialization": false
  },
  "include": ["src"],                            // Only include source files
  "exclude": ["node_modules", "dist", "**/*.test.ts"] // Exclude build/test artifacts
}